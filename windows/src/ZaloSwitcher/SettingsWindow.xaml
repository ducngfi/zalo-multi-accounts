<Window x:Class="ZaloSwitcher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt" Width="560" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Icon="AppIcon.ico"
        Background="{StaticResource WindowBrush}" FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,0,0,6" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="Cách mở Zalo Switcher" Style="{StaticResource Section}" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <CheckBox x:Name="TrayIcon" Content="Hiện biểu tượng ở khay hệ thống (góc phải thanh tác vụ)" Click="TrayIconChanged" />
                <TextBlock Style="{StaticResource Note}"
                           Text="Khi có biểu tượng này, đóng cửa sổ Zalo Switcher chỉ ẩn nó đi; bấm biểu tượng để mở lại hoặc mở nhanh từng tài khoản. Nếu không thấy biểu tượng, hãy bấm mũi tên ^ cạnh đồng hồ. Khi tắt, đóng cửa sổ sẽ thoát Zalo Switcher." />
            </StackPanel>
        </Border>

        <TextBlock Text="Khởi động" Style="{StaticResource Section}" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <CheckBox x:Name="OpenAtLogin" Content="Mở Zalo Switcher khi đăng nhập Windows" Click="OpenAtLoginChanged" />
                <CheckBox x:Name="OpenAllAtLogin" Content="Khi đó, mở mọi tài khoản đã đăng nhập" Click="OpenAllAtLoginChanged" Margin="22,3,0,3" />
                <TextBlock Style="{StaticResource Note}"
                           Text="Khi tự mở cùng Windows, ứng dụng chạy ở khay hệ thống, không hiện cửa sổ, và mở mỗi tài khoản trong một cửa sổ Zalo riêng. Nếu Zalo cũng tự mở cùng Windows, Zalo chính sẽ mở như thường lệ." />
            </StackPanel>
        </Border>

        <TextBlock Text="Dung lượng" Style="{StaticResource Section}" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Content="−" Padding="12,2" Click="LessSpace" />
                        <Button Style="{StaticResource SecondaryButton}" Content="+" Padding="12,2" Margin="6,0,0,0" Click="MoreSpace" />
                    </StackPanel>
                    <TextBlock x:Name="SpaceLabel" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Style="{StaticResource Note}"
                           Text="Khi ổ đĩa gần đầy, Zalo có thể không lưu được tin nhắn. Dưới mức này, ứng dụng sẽ hỏi trước khi thêm hoặc mở thêm tài khoản." />
            </StackPanel>
        </Border>

        <TextBlock Text="Dữ liệu" Style="{StaticResource Section}" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Mở trong File Explorer" Click="ShowProfiles" />
                    <TextBlock Text="Các tài khoản đã lưu" VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Mở trong File Explorer" Click="ShowZaloData" />
                    <TextBlock Text="Dữ liệu của Zalo chính" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <TextBlock x:Name="VersionLabel" DockPanel.Dock="Right" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="Phiên bản" />
                </DockPanel>
                <TextBlock Style="{StaticResource Note}" Text="Zalo Switcher là dự án độc lập, không liên kết với Zalo hay VNG." />
            </StackPanel>
        </Border>

        <Button Content="Xong" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,18,0,0" Padding="22,7"
                IsDefault="True" IsCancel="True" Click="Done" />
    </StackPanel>
</Window>
